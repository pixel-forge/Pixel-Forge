{
  "name": "pixel-forge",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "clean": "pnpm -r --parallel run clean",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r --parallel run test:watch",
    "lint": "eslint .",
    "format": "prettier -c .",
    "format:write": "prettier -w .",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:prep": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && changeset version",
    "release:publish": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/changelog-git": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "rimraf": "^6.0.0",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
