{
  "name": "@pixel-forge/utils",
  "version": "0.2.0",
  "description": "Shared TypeScript utilities for Pixel Forge libraries.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-forge/Pixel-Forge.git",
    "directory": "packages/utils"
  },
  "homepage": "https://github.com/pixel-forge/Pixel-Forge/tree/main/packages/utils#readme",
  "bugs": "https://github.com/pixel-forge/Pixel-Forge/issues",
  "keywords": [
    "typescript",
    "utilities",
    "esm",
    "tree-shaking"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    "./array": "./dist/array/index.js",
    "./color": "./dist/color/index.js",
    "./object": "./dist/object/index.js",
    "./timing": "./dist/timing/index.js",
    "./types": "./dist/types/index.js",
    "./package.json": "./package.json"
  }
}
